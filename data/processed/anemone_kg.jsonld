  {
   "@id": "https://w3id.org/anemone-kg/habitat/2f1bec51-96dc-5fa6-bea7-40408cc0a9e5",
   "@type": "akv:HabitatStatement",
   "dcterms:subject": {
    "@id": "https://w3id.org/anemone-kg/taxon/56cdb3eb-a57a-53b2-a70d-2efc18827f05"
   },
   "dwc:habitat": {
    "@language": "en",
    "@value": "This species lives attached to hard substratum, inside holes or crevices among live corals and rocks, and commonly observed during day with only the pseudotentacles protruding into the water column; often between 0.5–12.0 m, but it has been reported down to 60 m depth (Ocaña et al. 2007)."
   },
   "dwciri:habitat": {
