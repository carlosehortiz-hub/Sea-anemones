  {
   "@id": "https://w3id.org/anemone-kg/habitat/47b8e85e-366e-5967-8570-9ce1712602ad",
   "@type": "akv:HabitatStatement",
   "dcterms:subject": {
    "@id": "https://w3id.org/anemone-kg/taxon/f1e54674-aa12-5b80-acae-893136f1e65a"
   },
   "dwc:habitat": {
    "@language": "en",
    "@value": "This species lives in shallow waters inside crevices of rocks and coral rubble, with only its tentacles above the substrate. It is often observed in caves and crevices at the interface between hard and sandy substratum, commonly between 0.5–15.0 m, but also observed down to 40 m."
   },
