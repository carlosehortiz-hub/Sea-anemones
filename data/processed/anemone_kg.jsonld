   "dwc:habitat": {
    "@language": "en",
    "@value": "This species lives attached to rocks, coral rubble, submerged lumber, or mangrove roots, often between 0.5–22.0 m. It is commonly observed forming aggregations as a result of asexual reproduction by pedal laceration (González-Muñoz et al. 2012)."
   },
