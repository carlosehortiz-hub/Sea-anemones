   },
   "dwc:habitat": {
    "@language": "en",
    "@value": "This species lives attached to hard substratum, inside crevices or holes of rocks or live coral, and commonly observed with only the pseudotentacles protruding into the water column; often between 0.5–6.0 m."
   },
