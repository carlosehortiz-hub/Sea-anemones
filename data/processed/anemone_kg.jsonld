   "dwc:habitat": {
    "@language": "en",
    "@value": "This species inhabit shallow waters, inside crevices formed by coral rocks and coral rubble, and is also commonly observed among seagrass meadows and mangroves zones; often between 0.5–30.0 m, but has been reported down to 40 m (Agudo 1987)."
   },
