   },
   "dwc:habitat": {
    "@language": "en",
    "@value": "This species lives attached to rocks or coral rubble, mostly in shallow waters, but not on intertidal zones, between 1.0–5.0 m."
   },
   "dwciri:substrate": {
    "@id": "http://purl.obolibrary.org/obo/ENVO_00001995"
   },
