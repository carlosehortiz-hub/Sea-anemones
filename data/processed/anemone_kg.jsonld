    "@id": "https://w3id.org/anemone-kg/taxon/1f4419df-02a5-5fb5-8385-4ff423eac5f9"
   },
   "dwc:habitat": {
    "@language": "en",
    "@value": "This species lives attached to hard substrate, under rocks of coral colonies, between 1.5–20.0 m."
   },
   "dwciri:substrate": {
