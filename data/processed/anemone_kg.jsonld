   "dwc:habitat": {
    "@language": "en",
    "@value": "This species inhabits sandy patches, with the pedal disc strongly attached to burrowed rocks, but with the column completely buried in the sand and only the oral disc and tentacles protruding into the water column, often between 1–2 m."
   },
   "dwciri:substrate": [
