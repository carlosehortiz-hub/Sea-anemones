{
 "@context": {
  "@version": 1.1,
  "ENVO": "http://purl.obolibrary.org/obo/ENVO_",
  "NCBITaxon": "http://purl.obolibrary.org/obo/NCBITaxon_",
  "ak": "https://w3id.org/anemone-kg/",
  "akv": "https://w3id.org/anemone-kg/vocab/",
  "dcat": "http://www.w3.org/ns/dcat#",
  "dcterms": "http://purl.org/dc/terms/",
  "dsw": "http://purl.org/dsw/",
  "dwc": "http://rs.tdwg.org/dwc/terms/",
  "dwciri": "http://rs.tdwg.org/dwc/iri/",
  "gbif": "https://www.gbif.org/species/",
  "owl": "http://www.w3.org/2002/07/owl#",
  "prov": "http://www.w3.org/ns/prov#",
  "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
  "semapv": "https://w3id.org/semapv/vocab/",
  "skos": "http://www.w3.org/2004/02/skos/core#",
  "sssom": "https://w3id.org/sssom/",
  "worms": "urn:lsid:marinespecies.org:taxname:",
  "xsd": "http://www.w3.org/2001/XMLSchema#"
 },
 "@graph": [
  {
   "@id": "akv:",
   "@type": "owl:Ontology",
   "dcterms:description": {
    "@language": "en",
    "@value": "Terms used by the anemone-kg knowledge graph that have no equivalent in Darwin Core, Darwin-SW, PROV-O, DCTERMS, SKOS or SSSOM."
   },
   "dcterms:license": {
    "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
   },
   "dcterms:title": {
    "@language": "en",
    "@value": "anemone-kg project vocabulary"
   },
   "owl:versionInfo": "0.1.0"
  },
  {
   "@id": "akv:HabitatStatement",
   "@type": "owl:Class",
   "rdfs:comment": {
    "@language": "en",
    "@value": "The Habitat paragraph of a species account: a statement about where a taxon lives, made by the authors of the source. Darwin Core places dwc:habitat on dwc:Event (one collecting event); here habitat is described per species, so it needs its own node. The text is in dwc:habitat, the ENVO terms in dwciri:habitat and dwciri:substrate."
   },
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "habitat statement"
   },
   "rdfs:subClassOf": {
    "@id": "prov:Entity"
   }
  },
  {
   "@id": "akv:Literature",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Table 1 codes 'b' to 'j': a record in a previously published work, cited in the legend."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceKinds"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "previously published record"
   }
  },
  {
   "@id": "akv:LiteratureRecord",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Codes 'b'-'j': a record in an earlier publication, cited by the article and not consulted here; whether it rests on a voucher is unknown, and its name cannot be fixed to a current taxon concept."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceTiers"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "literature record"
   }
  },
  {
   "@id": "akv:MohbrCollection",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Table 1 code 'a': a specimen in the collection of the Museo Oceanológico Hermano Benigno Román."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceKinds"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "MOHBR collection specimen"
   }
  },
  {
   "@id": "akv:MuseumConfirmed",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Code 'a' with a Table 3 (Appendix 2) specimen of that taxon and area whose current identification agrees."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceTiers"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "museum record, identification confirmed"
   }
  },
  {
   "@id": "akv:MuseumReidentified",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Code 'a' traceable only to a Table 3 specimen whose previous identification is the taxon and whose current identification is another taxon."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceTiers"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "museum record, specimen re-identified"
   }
  },
  {
   "@id": "akv:MuseumUnconfirmed",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Code 'a' traceable only to a Table 3 specimen whose previous identification is the taxon and which the article lists as 'not identified'."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceTiers"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "museum record, specimen not identified"
   }
  },
  {
   "@id": "akv:MuseumUntraced",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Code 'a' without any Table 3 specimen of that taxon from that area, although the legend refers code 'a' to Appendix 2."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceTiers"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "museum record, not traced"
   }
  },
  {
   "@id": "akv:SurveyUnvouchered",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Code '*' without a Table 2 specimen of that taxon and area. The legend ('records documented in our surveys') does not say whether a specimen was taken."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceTiers"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "survey record, no voucher"
   }
  },
  {
   "@id": "akv:SurveyVouchered",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Code '*' with a Table 2 specimen of the same taxon (by WoRMS accepted name) from the same area, identified without qualifier. Best tier for '*'."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceTiers"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "survey record, vouchered"
   }
  },
  {
   "@id": "akv:SurveyVoucheredQualified",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Code '*' whose only matching Table 2 specimen is identified with cf. or sp."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceTiers"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "survey record, voucher identified with qualifier"
   }
  },
  {
   "@id": "akv:ThisSurvey",
   "@type": "skos:Concept",
   "skos:definition": {
    "@language": "en",
    "@value": "Table 1 code '*': recorded in the authors' own surveys (specimens or observations)."
   },
   "skos:inScheme": {
    "@id": "akv:evidenceKinds"
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "documented in this survey"
   }
  },
  {
   "@id": "akv:evidenceKinds",
   "@type": "skos:ConceptScheme",
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "skos:definition": {
    "@language": "en",
    "@value": "What kind of evidence a code in Table 1 of the source asserts presence on."
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "Evidence kinds of Table 1"
   }
  },
  {
   "@id": "akv:evidenceTier",
   "@type": "owl:ObjectProperty",
   "rdfs:comment": {
    "@language": "en",
    "@value": "How directly a Table 1 assertion can be traced to examined material. Derived by the pipeline from the cross-table comparison (anemone_kg.dq.crosstable.evidence_tiers), not stated by the source. It is not dwc:identificationVerificationStatus: it grades the presence record, not an identification."
   },
   "rdfs:domain": {
    "@id": "dwc:Occurrence"
   },
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "evidence tier"
   },
   "rdfs:range": {
    "@id": "skos:Concept"
   }
  },
  {
   "@id": "akv:evidenceTiers",
   "@type": "skos:ConceptScheme",
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "skos:definition": {
    "@language": "en",
    "@value": "Graded traceability of a presence assertion to examined material, for fitness-for-use decisions."
   },
   "skos:prefLabel": {
    "@language": "en",
    "@value": "Evidence tiers of Table 1 assertions"
   }
  },
  {
   "@id": "akv:hasAcceptedName",
   "@type": "owl:ObjectProperty",
   "rdfs:comment": {
    "@language": "en",
    "@value": "Links a name record to the record of its accepted name. IRI-valued counterpart of dwc:acceptedNameUsageID: Darwin Core terms in the dwc: namespace take literal values, and dwciri: has no accepted-name term."
   },
   "rdfs:domain": {
    "@id": "dwc:Taxon"
   },
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "has accepted name"
   },
   "rdfs:range": {
    "@id": "dwc:Taxon"
   },
   "skos:closeMatch": {
    "@id": "dwc:acceptedNameUsageID"
   }
  },
  {
   "@id": "akv:hasDoubtfulPreviousRecords",
   "@type": "owl:DatatypeProperty",
   "rdfs:comment": {
    "@language": "en",
    "@value": "True when the source marks a taxon with '?' in Table 1: earlier records of it for the country are doubtful. This qualifies the records, not the name, so dwc:taxonomicStatus does not fit."
   },
   "rdfs:domain": {
    "@id": "dwc:Taxon"
   },
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "has doubtful previous records"
   },
   "rdfs:range": {
    "@id": "xsd:boolean"
   }
  },
  {
   "@id": "akv:isNewCountryRecord",
   "@type": "owl:DatatypeProperty",
   "rdfs:comment": {
    "@language": "en",
    "@value": "True when the source reports the occurrence as the first record of the taxon for the country of its location (Table 1 code 'N'). Darwin Core has no term for this; dwc:establishmentMeans and dwc:degreeOfEstablishment describe how an organism got there, not whether it was recorded before."
   },
   "rdfs:domain": {
    "@id": "dwc:Occurrence"
   },
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "is new country record"
   },
   "rdfs:range": {
    "@id": "xsd:boolean"
   }
  },
  {
   "@id": "akv:sampledInStudy",
   "@type": "owl:DatatypeProperty",
   "rdfs:comment": {
    "@language": "en",
    "@value": "True for the six localities the authors sampled themselves (bold column headers in Table 1)."
   },
   "rdfs:domain": {
    "@id": "dcterms:Location"
   },
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "sampled in study"
   },
   "rdfs:range": {
    "@id": "xsd:boolean"
   }
  },
  {
   "@id": "akv:sourceLocator",
   "@type": "owl:DatatypeProperty",
   "rdfs:comment": {
    "@language": "en",
    "@value": "Where inside the source document a derived record comes from, e.g. 'Table 2, row 25'. PROV-O has no locator property, and dcterms:bibliographicCitation describes a resource as a whole, not a position within it."
   },
   "rdfs:domain": {
    "@id": "prov:Derivation"
   },
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "source locator"
   },
   "rdfs:range": {
    "@id": "xsd:string"
   }
  },
  {
   "@id": "akv:sourcePage",
   "@type": "owl:DatatypeProperty",
   "rdfs:comment": {
    "@language": "en",
    "@value": "Page of the source document on which the record is printed. Companion to akv:sourceLocator."
   },
   "rdfs:domain": {
    "@id": "prov:Derivation"
   },
   "rdfs:isDefinedBy": {
    "@id": "akv:"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "source page"
   },
   "rdfs:range": {
    "@id": "xsd:positiveInteger"
   }
  },
