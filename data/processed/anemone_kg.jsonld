  {
   "@id": "https://w3id.org/anemone-kg/habitat/13791a74-d2f6-5203-bb60-5dd085ff85a8",
   "@type": "akv:HabitatStatement",
   "dcterms:subject": {
    "@id": "https://w3id.org/anemone-kg/taxon/5c0e029d-ac6a-5dac-9607-9595ad911cdd"
   },
   "dwc:habitat": {
    "@language": "en",
    "@value": "This species lives commonly attached to coral rubble on sandy shores (González-Muñoz et al. 2013), between 0.5–1.5 m, with grains of sand adhered to the verrucae."
   },
   "dwciri:substrate": {
