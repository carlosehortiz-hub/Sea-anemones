    dwc:habitat "This species lives attached to rocks, commonly in shallow waters among rocky patches and seagrasses meadows, between 0.5–6.0 m."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/e1132f28-0b82-5d82-9013-980df25b8933#derivation> ;
