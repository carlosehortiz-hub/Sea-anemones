<https://w3id.org/anemone-kg/habitat/2f1bec51-96dc-5fa6-bea7-40408cc0a9e5> a akv:HabitatStatement ;
    dcterms:subject <https://w3id.org/anemone-kg/taxon/56cdb3eb-a57a-53b2-a70d-2efc18827f05> ;
    dwciri:habitat ENVO:01000294 ;
    dwciri:substrate ENVO:00001995 ;
    dwc:habitat "This species lives attached to hard substratum, inside holes or crevices among live corals and rocks, and commonly observed during day with only the pseudotentacles protruding into the water column; often between 0.5–12.0 m, but it has been reported down to 60 m depth (Ocaña et al. 2007)."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/2f1bec51-96dc-5fa6-bea7-40408cc0a9e5#derivation> ;
    prov:wasDerivedFrom <https://doi.org/10.1186/s41200-016-0016-7> ;
    prov:wasGeneratedBy <https://w3id.org/anemone-kg/activity/annotate-envo> .

<https://w3id.org/anemone-kg/habitat/3098191f-1b37-5390-97a7-89a6c113fa98> a akv:HabitatStatement ;
    dcterms:subject <https://w3id.org/anemone-kg/taxon/73262c5b-81b3-53ab-aac3-35f8be9fc82b> ;
    dwciri:substrate ENVO:00001995 ;
    dwc:habitat "This species lives attached to hard substrate, under rocks or coral rubble, between 0.5–1.5 m."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/3098191f-1b37-5390-97a7-89a6c113fa98#derivation> ;
    prov:wasDerivedFrom <https://doi.org/10.1186/s41200-016-0016-7> ;
