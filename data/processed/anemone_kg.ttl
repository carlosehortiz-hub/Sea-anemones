    dwciri:habitat ENVO:01000145,
        ENVO:01000147 ;
    dwc:habitat "This species lives attached to sponges of several species, including Clathria virgultosa (Lamarck, 1814), Iotrochota birotulata (Higgin, 1877), and Agelas conifera (Schmidt, 1870); inhabits the fore-reef, and back-reef zones, between 6.0–25.0 m, but has been reported down to 50 m (Agudo 1987)."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/d74a960c-4d01-5b64-b85c-004ffa4ce2df#derivation> ;
    prov:wasDerivedFrom <https://doi.org/10.1186/s41200-016-0016-7> ;
    prov:wasGeneratedBy <https://w3id.org/anemone-kg/activity/annotate-envo> .

<https://w3id.org/anemone-kg/habitat/dc8d8dbe-8ec9-5a5d-b2af-6ea3c6b825d6> a akv:HabitatStatement ;
    dcterms:subject <https://w3id.org/anemone-kg/taxon/6a5398e8-1481-5d28-a4aa-84dff0f81d17> ;
    dwciri:habitat ENVO:01000294 ;
    dwciri:substrate ENVO:00001995 ;
    dwc:habitat "This species lives attached to hard substratum, inside crevices or holes of rocks or live coral, and commonly observed with only the pseudotentacles protruding into the water column; often between 0.5–6.0 m."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/dc8d8dbe-8ec9-5a5d-b2af-6ea3c6b825d6#derivation> ;
    prov:wasDerivedFrom <https://doi.org/10.1186/s41200-016-0016-7> ;
    prov:wasGeneratedBy <https://w3id.org/anemone-kg/activity/annotate-envo> .

