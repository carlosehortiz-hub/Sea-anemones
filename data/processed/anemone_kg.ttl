<https://w3id.org/anemone-kg/habitat/88fe03af-292e-57c2-9796-9c2f9f6adc41> a akv:HabitatStatement ;
    dcterms:subject <https://w3id.org/anemone-kg/taxon/5eb69c15-0525-5eb6-a914-45f35bb6fab9> ;
    dwciri:habitat ENVO:01000294 ;
    dwciri:substrate ENVO:00001995 ;
    dwc:habitat "This species lives attached to hard substratum, inside crevices or holes of rocks or coral rubble with only the tentacles protruding into the water column, often between 0.5–10.0 m."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/88fe03af-292e-57c2-9796-9c2f9f6adc41#derivation> ;
