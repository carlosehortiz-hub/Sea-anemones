<https://w3id.org/anemone-kg/habitat/13791a74-d2f6-5203-bb60-5dd085ff85a8> a akv:HabitatStatement ;
    dcterms:subject <https://w3id.org/anemone-kg/taxon/5c0e029d-ac6a-5dac-9607-9595ad911cdd> ;
    dwciri:substrate ENVO:01000017 ;
    dwc:habitat "This species lives commonly attached to coral rubble on sandy shores (González-Muñoz et al. 2013), between 0.5–1.5 m, with grains of sand adhered to the verrucae."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/13791a74-d2f6-5203-bb60-5dd085ff85a8#derivation> ;
    prov:wasDerivedFrom <https://doi.org/10.1186/s41200-016-0016-7> ;
    prov:wasGeneratedBy <https://w3id.org/anemone-kg/activity/annotate-envo> .

<https://w3id.org/anemone-kg/habitat/28981412-89c2-5c64-aa84-5e7c096388b6> a akv:HabitatStatement ;
    dcterms:subject <https://w3id.org/anemone-kg/taxon/1f4419df-02a5-5fb5-8385-4ff423eac5f9> ;
    dwciri:substrate ENVO:00001995 ;
    dwc:habitat "This species lives attached to hard substrate, under rocks of coral colonies, between 1.5–20.0 m."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/28981412-89c2-5c64-aa84-5e7c096388b6#derivation> ;
