<https://w3id.org/anemone-kg/habitat/28981412-89c2-5c64-aa84-5e7c096388b6> a akv:HabitatStatement ;
    dcterms:subject <https://w3id.org/anemone-kg/taxon/1f4419df-02a5-5fb5-8385-4ff423eac5f9> ;
    dwciri:substrate ENVO:00001995 ;
    dwc:habitat "This species lives attached to hard substrate, under rocks of coral colonies, between 1.5–20.0 m."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/28981412-89c2-5c64-aa84-5e7c096388b6#derivation> ;
    prov:wasDerivedFrom <https://doi.org/10.1186/s41200-016-0016-7> ;
