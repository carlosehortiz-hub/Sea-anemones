    dwciri:substrate ENVO:00001995 ;
    dwc:habitat "This species lives attached to rocks or coral rubble, in shallow waters between 0.5–7.0 m."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/e0212b82-8353-59d3-8589-971ce327635b#derivation> ;
