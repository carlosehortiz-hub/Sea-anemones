    dwciri:substrate ENVO:00001995 ;
    dwc:habitat "This species lives strongly attached to rocks or coral rubble, hidden below the rocks, between 15.0–25.0 m, but it has been reported down to 97 m depth (Agudo 1987)."@en ;
    prov:qualifiedDerivation <https://w3id.org/anemone-kg/habitat/c49337a5-dafd-55e7-8337-5ae6466565d9#derivation> ;
    prov:wasDerivedFrom <https://doi.org/10.1186/s41200-016-0016-7> ;
