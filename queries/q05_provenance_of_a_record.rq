# title: Provenance of a record and of its identifiers
# question: Where does specimen MOHBR I-547 come from in the paper, and how was each identifier of its taxon resolved (service, predicate, justification, method, request, time)?
# why: Every record is traceable to the paper (table, row, page, pipeline stage) and every identifier to the API response it came from.
PREFIX dwc:     <http://rs.tdwg.org/dwc/terms/>
PREFIX dwciri:  <http://rs.tdwg.org/dwc/iri/>
PREFIX dsw:     <http://purl.org/dsw/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sssom:   <https://w3id.org/sssom/>
PREFIX akv:     <https://w3id.org/anemone-kg/vocab/>

SELECT ?catalogNumber ?sourceLocator ?page ?stage ?taxonName ?service ?predicate ?identifier
       ?justification ?method ?request ?retrieved
WHERE {
  VALUES ?catalogNumber { "I-547" }
  ?occ dwc:catalogNumber ?catalogNumber ;
       prov:qualifiedDerivation ?d ;
       dwciri:toTaxon ?taxon .
  ?d akv:sourceLocator ?sourceLocator ; akv:sourcePage ?page ; prov:hadActivity ?stage .
  ?taxon dwc:scientificName ?taxonName .
  ?m owl:annotatedSource ?taxon ;
     owl:annotatedProperty ?predicate ;
     owl:annotatedTarget ?identifier ;
     sssom:mapping_justification ?justification ;
     rdfs:comment ?method ;
     prov:wasGeneratedBy ?activity ;
     prov:wasDerivedFrom ?response .
  ?activity prov:wasAssociatedWith ?agent .
  ?agent rdfs:label ?service .
  FILTER (?agent != <https://w3id.org/anemone-kg/agent/anemone-kg>)
  ?response dcterms:source ?request ; prov:generatedAtTime ?retrieved .
}
ORDER BY ?service
