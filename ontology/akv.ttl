@prefix akv:     <https://w3id.org/anemone-kg/vocab/> .
@prefix dwc:     <http://rs.tdwg.org/dwc/terms/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Minimal project vocabulary. A term is here only when no reused vocabulary
# (Darwin Core, Darwin-SW, PROV-O, DCTERMS, SKOS, SSSOM) has one; each comment
# says which existing term was considered and why it does not fit.
# The namespace IRI is a placeholder: it is not registered with w3id.org.

<https://w3id.org/anemone-kg/vocab/>
    a owl:Ontology ;
    dcterms:title "anemone-kg project vocabulary"@en ;
    dcterms:description "Terms used by the anemone-kg knowledge graph that have no equivalent in Darwin Core, Darwin-SW, PROV-O, DCTERMS, SKOS or SSSOM."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:versionInfo "0.1.0" .

# ------------------------------------------------------------------ classes

akv:HabitatStatement
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "habitat statement"@en ;
    rdfs:comment "The Habitat paragraph of a species account: a statement about where a taxon lives, made by the authors of the source. Darwin Core places dwc:habitat on dwc:Event (one collecting event); here habitat is described per species, so it needs its own node. The text is in dwc:habitat, the ENVO terms in dwciri:habitat and dwciri:substrate."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

# --------------------------------------------------------------- properties

akv:sourceLocator
    a owl:DatatypeProperty ;
    rdfs:domain prov:Derivation ;
    rdfs:range xsd:string ;
    rdfs:label "source locator"@en ;
    rdfs:comment "Where inside the source document a derived record comes from, e.g. 'Table 2, row 25'. PROV-O has no locator property, and dcterms:bibliographicCitation describes a resource as a whole, not a position within it."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

akv:sourcePage
    a owl:DatatypeProperty ;
    rdfs:domain prov:Derivation ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "source page"@en ;
    rdfs:comment "Page of the source document on which the record is printed. Companion to akv:sourceLocator."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

akv:isNewCountryRecord
    a owl:DatatypeProperty ;
    rdfs:domain dwc:Occurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "is new country record"@en ;
    rdfs:comment "True when the source reports the occurrence as the first record of the taxon for the country of its location (Table 1 code 'N'). Darwin Core has no term for this; dwc:establishmentMeans and dwc:degreeOfEstablishment describe how an organism got there, not whether it was recorded before."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

akv:hasDoubtfulPreviousRecords
    a owl:DatatypeProperty ;
    rdfs:domain dwc:Taxon ;
    rdfs:range xsd:boolean ;
    rdfs:label "has doubtful previous records"@en ;
    rdfs:comment "True when the source marks a taxon with '?' in Table 1: earlier records of it for the country are doubtful. This qualifies the records, not the name, so dwc:taxonomicStatus does not fit."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

akv:hasAcceptedName
    a owl:ObjectProperty ;
    rdfs:domain dwc:Taxon ;
    rdfs:range dwc:Taxon ;
    rdfs:label "has accepted name"@en ;
    rdfs:comment "Links a name record to the record of its accepted name. IRI-valued counterpart of dwc:acceptedNameUsageID: Darwin Core terms in the dwc: namespace take literal values, and dwciri: has no accepted-name term."@en ;
    skos:closeMatch dwc:acceptedNameUsageID ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

akv:sampledInStudy
    a owl:DatatypeProperty ;
    rdfs:domain dcterms:Location ;
    rdfs:range xsd:boolean ;
    rdfs:label "visited in study"@en ;
    rdfs:comment "True for the six localities whose column header is bold in Table 1: the areas the authors visited themselves (four reserves in November 2012, and observations and collections at Isla de Cubagua and Chichiriviche). Effort and season are not reported, so the flag means 'visited', not 'surveyed for absence'."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

# ----------------------------------------------------- evidence-kind scheme

akv:evidenceKinds
    a skos:ConceptScheme ;
    skos:prefLabel "Evidence kinds of Table 1"@en ;
    skos:definition "What kind of evidence a code in Table 1 of the source asserts presence on."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

akv:ThisSurvey
    a skos:Concept ;
    skos:inScheme akv:evidenceKinds ;
    skos:prefLabel "documented in this survey"@en ;
    skos:definition "Table 1 code '*': '(*) records documented in our surveys' (legend). The source deposited vouchers per species, not per area, and also photographed and observed; a '*' does not imply a voucher from that area."@en .

akv:MohbrCollection
    a skos:Concept ;
    skos:inScheme akv:evidenceKinds ;
    skos:prefLabel "MOHBR collection specimen (previous record)"@en ;
    skos:definition "Table 1 code 'a', listed in the legend under 'Citation of previous records': 'Specimens of the MOHBR scientific collection (see Appendix 2)', deposited earlier by other collectors and re-examined by the authors."@en .

akv:Literature
    a skos:Concept ;
    skos:inScheme akv:evidenceKinds ;
    skos:prefLabel "previously published record"@en ;
    skos:definition "Table 1 codes 'b' to 'j': a record in a previously published work, cited in the legend."@en .

# ----------------------------------------------------- evidence-tier scheme

akv:evidenceTier
    a owl:ObjectProperty ;
    rdfs:domain dwc:Occurrence ;
    rdfs:range skos:Concept ;
    rdfs:label "evidence tier"@en ;
    rdfs:comment "How directly a Table 1 assertion can be traced to examined material. Derived by the pipeline from the cross-table comparison (anemone_kg.dq.crosstable.evidence_tiers), not stated by the source. It is not dwc:identificationVerificationStatus: it grades the presence record, not an identification."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

akv:citesSpecimen
    a owl:ObjectProperty ;
    rdfs:domain dwc:Occurrence ;
    rdfs:range dwc:Occurrence ;
    rdfs:label "cites specimen"@en ;
    rdfs:comment "Links a Table 1 assertion to the specimen occurrence (Table 2 or 3) it rests on, including a specimen now identified as another taxon or not identified, so that an organism is not counted twice. IRI-valued counterpart of dwc:associatedOccurrences, which takes a literal; the specimen's identification says whether it supports or contradicts the assertion."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .

akv:evidenceTiers
    a skos:ConceptScheme ;
    skos:prefLabel "Evidence tiers of Table 1 assertions"@en ;
    skos:definition "Graded traceability of a presence assertion to examined material, for fitness-for-use decisions."@en ;
    rdfs:isDefinedBy <https://w3id.org/anemone-kg/vocab/> .


akv:SurveyVouchered
    a skos:Concept ;
    skos:inScheme akv:evidenceTiers ;
    skos:prefLabel "survey code, specimen from the area"@en ;
    skos:definition "Code '*' with a Table 2 specimen of the same taxon (by WoRMS accepted name) from the same area, identified without qualifier. Best tier for '*'."@en .

akv:SurveyVoucheredQualified
    a skos:Concept ;
    skos:inScheme akv:evidenceTiers ;
    skos:prefLabel "survey code, specimen from the area identified with qualifier"@en ;
    skos:definition "Code '*' whose only matching Table 2 specimen is identified with cf. or sp."@en .

akv:SurveyUnvouchered
    a skos:Concept ;
    skos:inScheme akv:evidenceTiers ;
    skos:prefLabel "survey code, no specimen from the area"@en ;
    skos:definition "Code '*' without a Table 2 specimen of that taxon and area. The legend does not require a specimen, and the source vouchered each species once, so for most such codes the species is vouchered from another area; two species of the survey are not vouchered at all."@en .

akv:MuseumConfirmed
    a skos:Concept ;
    skos:inScheme akv:evidenceTiers ;
    skos:prefLabel "museum code, matching specimen"@en ;
    skos:definition "Code 'a' with a Table 3 (Appendix 2) specimen of that taxon and area whose current identification agrees."@en .

akv:MuseumReidentified
    a skos:Concept ;
    skos:inScheme akv:evidenceTiers ;
    skos:prefLabel "museum code, specimen now another taxon"@en ;
    skos:definition "Code 'a' traceable only to a Table 3 specimen whose previous identification is the taxon and whose current identification is another taxon: the article's own counter-evidence. Ranked below an untraced code."@en .

akv:MuseumUnconfirmed
    a skos:Concept ;
    skos:inScheme akv:evidenceTiers ;
    skos:prefLabel "museum code, specimen not identified"@en ;
    skos:definition "Code 'a' traceable only to a Table 3 specimen whose previous identification is the taxon and which the article lists as 'not identified'."@en .

akv:MuseumUntraced
    a skos:Concept ;
    skos:inScheme akv:evidenceTiers ;
    skos:prefLabel "museum code, no specimen listed"@en ;
    skos:definition "Code 'a' without any Table 3 specimen of that taxon from that area, although the legend refers code 'a' to Appendix 2."@en .

akv:LiteratureRecord
    a skos:Concept ;
    skos:inScheme akv:evidenceTiers ;
    skos:prefLabel "literature record"@en ;
    skos:definition "Codes 'b'-'j': a record in an earlier publication, cited by the article and not consulted here; whether it rests on a voucher is unknown, and its name cannot be fixed to a current taxon concept."@en .
