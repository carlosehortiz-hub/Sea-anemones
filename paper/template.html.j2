<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ short_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="front">
  <div class="banner"><span>Research</span><span>Manuscript, not peer reviewed</span></div>
  <h1 class="title">{{ title }}</h1>
  <p class="authors">{{ authors | safe }}</p>
  <section class="abstract">
    <h2>Abstract</h2>
    <p><b>Background:</b> {{ abstract.background | safe }}</p>
    <p><b>Results:</b> {{ abstract.results | safe }}</p>
    <p><b>Conclusions:</b> {{ abstract.conclusions | safe }}</p>
    <p class="keywords"><b>Keywords:</b> {{ keywords }}</p>
  </section>
  <aside class="affil">
    {{ affiliations | safe }}
  </aside>
</header>
<main class="body">
{{ body | safe }}
</main>
</body>
</html>
